# Farmaa Backend Development Environment Configuration
# Copy this file to .env for local development

# Database Configuration (Required)
# For local PostgreSQL: postgresql://username:password@localhost:5432/farmaa_dev
# For Supabase: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# JWT Configuration (Required)
SECRET_KEY=farmaa-development-secret-key-change-in-production

# Environment Configuration
ENVIRONMENT=development

# Logging Configuration (more verbose in development)
LOG_LEVEL=DEBUG
