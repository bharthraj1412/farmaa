# Farmaa Backend Production Environment Configuration
# Copy this file to .env and fill in your actual values for production

# Database Configuration (Required)
DATABASE_URL=postgresql://username:password@host:port/database_name

# JWT Configuration (Required - Generate a secure random string)
SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long

# Environment Configuration
ENVIRONMENT=production

# Optional: Database Pool Configuration
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=300

# Optional: Logging Configuration
# LOG_LEVEL=INFO
